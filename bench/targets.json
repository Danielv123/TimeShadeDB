    {"id": "client_first_paint_p95", "group": "Client", "title": "First full paint, cold, p95", "tool": "webbench", "scenario": "testdata", "metric": "web.first_full_paint_cold_ms.p95", "op": "<=", "value": 900, "unit": "ms", "plan_baseline": "illisis about 4.6 s cold per long chain"},

    {"id": "client_scrub_bytes", "group": "Client", "title": "Time scrub step: bytes beyond the changed tiles (unchanged tile versions downloaded again, sum over the steps)", "tool": "webbench", "scenario": "testdata", "metric": "web.scrub_unchanged_tile_bytes", "op": "<=", "value": 0, "unit": "B", "plan_baseline": "TSDB refetches the whole viewport"},

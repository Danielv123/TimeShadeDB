{
  "about": "PLAN.md section 5 targets, one row per checkable number. 'metric' is a key in a result file's metrics; 'tool' and 'scenario' select the result files ('a|b': the first listed tool, then scenario, that has the metric wins, newest result within one; '*': any tool, newest). The v3 stream re-ingest uses scenario testdata-stream so it never stands in for the imported database; 'op' and 'value' are the pass condition for the candidate (v3). 'plan_baseline' quotes the plan's baseline column. bench/cmd/report reads this file.",
  "targets": [
    {"id": "import_time", "group": "Import", "title": "Import of the full test data (WP5)", "tool": "measure-run", "scenario": "testdata", "metric": "import.seconds", "op": "<=", "value": 30, "unit": "s", "plan_baseline": "n/a (Python prototype: about 35 s for terrain)"},

    {"id": "ingest_chunks", "group": "Ingest", "title": "Live ingest: chunk updates per second", "tool": "ingestbench", "scenario": "synth", "metric": "ingest.chunk_rows_per_s", "op": ">=", "value": 100000, "unit": "updates/s", "plan_baseline": "59 k rows/s over HTTP, slowing as the index grows"},
    {"id": "ingest_movers", "group": "Ingest", "title": "Live ingest: mover samples per second", "tool": "ingestbench", "scenario": "synth", "metric": "ingest.mover_samples_per_s", "op": ">=", "value": 500000, "unit": "samples/s", "plan_baseline": "n/a (v2 has no mover store)"},
    {"id": "ingest_flat", "group": "Ingest", "title": "Ingest rate flat over a 10x history (last tenth / second tenth)", "tool": "ingestbench", "scenario": "synth", "metric": "ingest.chunk_flatness", "op": ">=", "value": 0.8, "unit": "ratio", "plan_baseline": "slowing as the index grows"},

    {"id": "disk_z0", "group": "Disk", "title": "Terrain disk at 60 s windows, z0 incl. index (nauvis)", "tool": "measure-v3disk|measure-illisis|ingestbench", "scenario": "testdata", "metric": "disk.b_per_chunk_hour_z0", "op": "<=", "value": 4, "unit": "B/chunk-hour", "plan_baseline": "illisis 69 B/chunk-hour; TSDB about 22 B per changed pixel"},
    {"id": "disk_terrain", "group": "Disk", "title": "Terrain disk including the pyramid (nauvis)", "tool": "measure-v3disk|measure-illisis|ingestbench", "scenario": "testdata", "metric": "disk.b_per_chunk_hour_terrain", "op": "<=", "value": 5, "unit": "B/chunk-hour", "plan_baseline": "illisis 69 B/chunk-hour (z0 only)"},
    {"id": "disk_movers", "group": "Disk", "title": "Mover disk per sample, incl. heading and tick", "tool": "measure-v3disk|measure-illisis", "scenario": "testdata", "metric": "disk.mover_b_per_sample", "op": "<=", "value": 6, "unit": "B/sample", "plan_baseline": "12.9 B/sample (illisis)"},
    {"id": "disk_total", "group": "Disk", "title": "Whole test map stored (movers, overlays, pyramid included)", "tool": "measure-v3disk|measure-illisis|ingestbench", "scenario": "testdata-all", "metric": "disk.store_mib", "op": "<=", "value": 20, "unit": "MiB", "plan_baseline": "133.5 MB (illisis)"},

    {"id": "rss_bound", "group": "Memory", "title": "Server RSS at any history length (soak maximum)", "tool": "soak", "scenario": "soak", "metric": "mem.max_rss_mib", "op": "<=", "value": 320, "unit": "MiB", "plan_baseline": "grows 4.1-8.8 KB/row; 1.1-2.7 GB in tests"},
    {"id": "rss_growth", "group": "Memory", "title": "RSS growth, end of first sixth to end of soak (hour 1 to hour 6)", "tool": "soak", "scenario": "soak", "metric": "soak.rss_growth_ratio", "op": "<", "value": 0.05, "unit": "ratio", "plan_baseline": "grows 4.1-8.8 KB/row"},
    {"id": "rss_ingest", "group": "Memory", "title": "Server RSS after ingesting the test data stream over HTTP", "tool": "ingestbench", "scenario": "testdata-stream|testdata", "metric": "mem.max_rss_mib", "op": "<=", "value": 320, "unit": "MiB", "plan_baseline": "1.1-2.7 GB in tests"},
    {"id": "rss_ingest_synth", "group": "Memory", "title": "Server RSS while ingesting the synthetic workload at full speed (1 M chunk updates, 5 M mover samples)", "tool": "ingestbench", "scenario": "synth", "metric": "mem.max_rss_mib", "op": "<=", "value": 320, "unit": "MiB", "plan_baseline": "1.1-2.7 GB in tests"},

